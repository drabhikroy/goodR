{
  "name": "goodr",
  "productName": "Good For",
  "version": "0.2.0",
  "private": true,
  "description": "R: What Is It Good For? A desktop workspace for R.",
  "author": "Abhik Roy",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tauri dev --no-watch",
    "tauri": "tauri",
    "fetch-ark": "node scripts/fetch-ark.mjs",
    "test": "vitest run",
    "test:ui": "playwright test",
    "standards": "node scripts/standards/check.mjs",
    "audit:contrast": "node scripts/standards/contrast.mjs",
    "verify": "npm run standards && npm run audit:contrast && npm run build && npm test && cargo test --workspace"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/fira-code": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/source-code-pro": "5.3.1",
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-dialog": "2.8.2",
    "@tauri-apps/plugin-opener": "2.7.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.0",
    "@tauri-apps/cli": "2.12.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
